{
  "scraper_settings": {
    "max_concurrent": 25,
    "batch_size": 100,
    "delay_between_batches": 0.2,
    "timeout_seconds": 60,
    "max_retries": 3,
    "retry_backoff_base": 1,
    "retry_backoff_max": 30
  },
  "performance": {
    "memory_threshold_mb": 512,
    "enable_monitoring": true,
    "log_level": "INFO",
    "collect_metrics": true
  },
  "update_policy": {
    "min_change_threshold": 10,
    "auto_download_enabled": true,
    "backup_before_update": true,
    "verify_checksum": true,
    "check_interval_hours": 24
  },
  "database": {
    "optimize_on_startup": true,
    "cleanup_old_errors_days": 30,
    "enable_history_tracking": true,
    "connection_pool_size": 20
  },
  "release_management": {
    "keep_latest_count": 30,
    "tag_prefix": "data-",
    "latest_tag": "latest-data",
    "auto_cleanup": true,
    "create_backup": true
  },
  "client_behavior": {
    "user_agent": "TariffUpdater/1.0 (SmartUpdate Client)",
    "request_timeout": 30,
    "max_redirects": 5,
    "verify_ssl": true
  }
}